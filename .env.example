# Copy to .env and fill in real values.  .env is gitignored — never commit it.
#   cp .env.example .env

# Required: shared secret for the X-API-Key header on write endpoints.
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
VPS_API_KEY=replace-me

# Path to the DuckDB file (inside the container).
DUCKDB_PATH=/app/data.duckdb

# Optional: Alpaca paper trading.  Leave ALPACA_ENABLED unset/false for dry-run.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_ENABLED=false
